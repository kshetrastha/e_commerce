@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Id</td>
            <td>@product.Title</td>
            <td>@product.Price.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>
